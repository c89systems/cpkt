cmake_minimum_required(VERSION 3.21)
if(CPKT_SYSTEM STREQUAL "Darwin")
  set(arguments -gU)
else()
  set(arguments -D --defined-only)
endif()
function(functions library output)
  execute_process(COMMAND "${CPKT_NM}" ${arguments} "${library}"
    RESULT_VARIABLE result OUTPUT_VARIABLE symbols ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect ${library}: ${error}")
  endif()
  string(REPLACE "\n" ";" lines "${symbols}")
  set(names "")
  foreach(line IN LISTS lines)
    if(line MATCHES "[ \t]T[ \t]+([^ \t@]+)")
      set(name "${CMAKE_MATCH_1}")
      if(CPKT_SYSTEM STREQUAL "Darwin")
        string(REGEX REPLACE "^_" "" name "${name}")
      endif()
      if(NOT name MATCHES "^_(init|fini)$")
        list(APPEND names "${name}")
      endif()
    endif()
  endforeach()
  list(SORT names)
  set(${output} "${names}" PARENT_SCOPE)
endfunction()
functions("${CPKT_NATIVE}" native)
functions("${CPKT_FACADE}" facade)
# These five unheadered compatibility initializers take version/size arguments.
# The native header exposes their versionless counterparts, all covered below.
list(REMOVE_ITEM native zng_deflateInit_ zng_deflateInit2_ zng_inflateInit_
  zng_inflateInit2_ zng_inflateBackInit_)
set(mapped "")
foreach(name IN LISTS native)
  if(name STREQUAL "zlibng_version")
    list(APPEND mapped cpkt_zlibng_version)
  elseif(name MATCHES "^zng_(.+)$")
    list(APPEND mapped "cpkt_zlibng_${CMAKE_MATCH_1}")
  else()
    message(FATAL_ERROR "Unclassified native zlib-ng function: ${name}")
  endif()
endforeach()
list(SORT mapped)
file(STRINGS "${CPKT_CATALOG}" expected REGEX "^cpkt_")
list(SORT expected)
list(LENGTH native count)
if(NOT count EQUAL 82 OR NOT mapped STREQUAL expected OR NOT facade STREQUAL expected)
  message(FATAL_ERROR "zlib-ng native/facade public function or private-export contract changed")
endif()

 BER_LOG_PRINT_FN ber_pvt_log_print = ber_error_print;
 
+BER_LOG_PRINT_FN
+ber_set_log_print_fn( BER_LOG_PRINT_FN callback )
+{
+    BER_LOG_PRINT_FN previous = ber_pvt_log_print;

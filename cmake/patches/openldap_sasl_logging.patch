 * Various Cyrus SASL related stuff.
 */
 
+/* Route Cyrus records through the caller-selectable BER print sink. */
+static int
+ldap_sasl_log( void *context, int level, const char *message )
+{
+    size_t len;
+    char *line;
+    (void)context;
+    (void)level;
+    if ( message == NULL ) return SASL_OK;
+    len = strlen( message );
+    line = (char *)malloc( len + 2 );
+    if ( line == NULL ) return SASL_FAIL;
+    memcpy( line, message, len );
+    if ( len == 0 || message[len - 1] != '\n' ) line[len++] = '\n';
+    line[len] = '\0';
+    ber_pvt_log_print( line );
+    free( line );
+    return SASL_OK;
+}
+
+/* Unlike BER debug output, user-visible SASL status is never debug-filtered. */
+static void
+ldap_sasl_status( const char *format, ... )
+{
+    va_list ap;
+    int length;
+    char *line;
+    va_start( ap, format );
+    length = vsnprintf( NULL, 0, format, ap );
+    va_end( ap );
+    if ( length < 0 ) return;
+    line = (char *)malloc( (size_t)length + 1 );
+    if ( line == NULL ) return;
+    va_start( ap, format );
+    (void)vsnprintf( line, (size_t)length + 1, format, ap );
+    va_end( ap );
+    ber_pvt_log_print( line );
+    free( line );
+}
+
+static const sasl_callback_t ldap_init_log_callbacks[] = {
+    { SASL_CB_LOG, (int (*)(void))ldap_sasl_log, NULL },
+    { SASL_CB_LIST_END, NULL, NULL }
+};
+
+static int
+ldap_sasl_has_custom_sink( void )
+{
+    BER_LOG_PRINT_FN sink = NULL;
+    (void)ber_get_option( NULL, LBER_OPT_LOG_PRINT_FN, &sink );
+    return sink != NULL && sink != ber_error_print;
+}

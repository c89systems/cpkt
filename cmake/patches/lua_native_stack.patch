+/* cpkt: cache belongs to the OS thread, not to a Lua state. New OS threads get
+** fresh TLS even when pthread IDs are reused. Refresh a Lua state's copy on
+** outer entry so serialized state migration and coroutine resumes stay valid.
+** Native thread stack mappings remain fixed for that OS thread's lifetime.
+*/
+LUAI_DDEF __thread NativeStackContext luaE_native_stack_context;
+
+uintptr_t luaE_initnativestack (void) {
+  uintptr_t low = 0;
+  size_t size = 0;
+#if defined(__linux__)
+  pthread_attr_t attributes;
+  void *base = NULL;
+  if (pthread_getattr_np(pthread_self(), &attributes) == 0) {
+    int status = pthread_attr_getstack(&attributes, &base, &size);
+    pthread_attr_destroy(&attributes);
+    if (status == 0)
+      low = cast(uintptr_t, base);
+    else
+      size = 0;
+  }
+#elif defined(__APPLE__)
+  uintptr_t high = cast(uintptr_t, pthread_get_stackaddr_np(pthread_self()));
+  size = pthread_get_stacksize_np(pthread_self());
+  if (high >= size)
+    low = high - size;
+  else
+    size = 0;
+#else
+#error Unsupported cpkt Lua native stack platform
+#endif
+  if (size > 16384 && low <= UINTPTR_MAX - size)
+    return low + 16384;
+  /* Failed discovery is retried on the next outer entry, never guessed. */
+  return UINTPTR_MAX;
+}
+
+void luaE_nativestackerror (lua_State *L, uintptr_t position) {
+  if (L->cpkt_stack_limit == UINTPTR_MAX) {
+    if (!completestate(G(L)))  /* lua_newstate can only report initialization failure */
+      luaD_throw(L, LUA_ERRMEM);
+    luaD_checkstack(L, LUA_MINSTACK);
+    /* Do not invoke an error handler that would need undiscovered bounds. */
+    setsvalue2s(L, L->top.p, luaS_newliteral(L, "native stack bounds unavailable"));
+    L->top.p++;
+    luaD_throw(L, LUA_ERRRUN);
+  }
+  /* The physical reserve also applies to first entry on another Lua state. */
+  if (position <= L->cpkt_stack_limit - 8192) {
+    luaD_checkstack(L, LUA_MINSTACK);
+    luaD_errerr(L);
+  }
+  if (!L->cpkt_stack_context->overflow) {
+    L->cpkt_stack_context->overflow = 1;
+    /* Entry checks may run while callers are using EXTRA_STACK slots. */
+    luaD_checkstack(L, LUA_MINSTACK);
+    luaG_runerror(L, "C stack overflow");
+  }
+}

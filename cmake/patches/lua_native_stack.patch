+/* cpkt: recursive paths only compare an address with cached thread bounds.
+** All declared targets have downward-growing native stacks. Keep 16 KiB for
+** error handling, and stop recursive error handlers before the last 8 KiB.
+*/
+l_sinline uintptr_t luaD_nativeposition (void) {
+  uintptr_t position;
+#if defined(__x86_64__)
+  __asm__ volatile ("mov %%rsp, %0" : "=r" (position));
+#elif defined(__aarch64__) || defined(__arm__)
+  __asm__ volatile ("mov %0, sp" : "=r" (position));
+#else
+#error Unsupported cpkt Lua native stack architecture
+#endif
+  return position;
+}
+
+#define luaE_refreshnativestack(L) \
+  { NativeStackContext *cpkt_context = &luaE_native_stack_context; \
+    /* Materialize the address once instead of repeating TLS descriptors. */ \
+    __asm__ ("" : "+r" (cpkt_context)); \
+    uintptr_t cpkt_limit = cpkt_context->limit; \
+    if (l_unlikely(cpkt_limit == 0 || cpkt_limit == UINTPTR_MAX)) \
+      cpkt_context->limit = cpkt_limit = luaE_initnativestack(); \
+    (L)->cpkt_stack_limit = cpkt_limit; \
+    (L)->cpkt_stack_context = cpkt_context; }
+
+#define luaD_checknativestack(L) \
+  { uintptr_t cpkt_stack_position = luaD_nativeposition(); \
+    if (l_unlikely(cpkt_stack_position <= (L)->cpkt_stack_limit)) \
+      luaE_nativestackerror((L), cpkt_stack_position); }
+
 

+static void KRB5_CALLCONV
+gss_trace_bridge(krb5_context context, const krb5_trace_info *info, void *data)
+{
+    (void)context;
+    (void)data;
+    if (info != NULL && gss_trace_callback != NULL)
+        gss_trace_callback(gss_trace_data, info->message);
+}

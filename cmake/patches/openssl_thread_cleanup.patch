Release the initialized master TLS key only after all global teardown handlers
have finished. Per-thread cleanup must leave the key usable by other threads.
Local fix for the static-plugin unload regression in tests/openssl_unload_test.c.

--- a/crypto/init.c
+++ b/crypto/init.c
@@ -27,6 +27,7 @@
 #include <stdlib.h>
 #include <assert.h>
 #include "internal/thread_once.h"
+#include "internal/threads_common.h"
 #include "crypto/dso_conf.h"
 #include "internal/dso.h"
 #include "crypto/store.h"
@@ -485,6 +486,8 @@
     OSSL_TRACE(INIT, "OPENSSL_cleanup: ossl_trace_cleanup()\n");
     ossl_trace_cleanup();
 
+    ossl_thread_cleanup_global();
+
     base_inited = 0;
 }
 
--- a/crypto/threads_common.c
+++ b/crypto/threads_common.c
@@ -412,3 +412,14 @@
         CRYPTO_THREAD_set_local(&master_key, NULL);
     }
 }
+
+/* Global teardown is single-threaded, after all users of the key have stopped. */
+void ossl_thread_cleanup_global(void)
+{
+    if (!master_key_init)
+        return;
+
+    CRYPTO_THREAD_clean_local();
+    CRYPTO_THREAD_cleanup_local(&master_key);
+    master_key_init = 0;
+}
--- a/include/internal/threads_common.h
+++ b/include/internal/threads_common.h
@@ -27,5 +27,6 @@
     OSSL_LIB_CTX *ctx, void *data);
 
 void CRYPTO_THREAD_clean_local(void);
+void ossl_thread_cleanup_global(void);
 
 #endif

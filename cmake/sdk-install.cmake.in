cmake_minimum_required(VERSION 3.21)
@CPKT_SDK_CONFIGURED_VALUES@
set(CPKT_SOURCE_DIR [==[@CMAKE_SOURCE_DIR@]==])
set(CPKT_BINARY_DIR [==[@CMAKE_BINARY_DIR@]==])
set(_stage_root "${CMAKE_INSTALL_PREFIX}")
file(READ "${CPKT_SOURCE_DIR}/cmake/components.json" _inventory)
string(JSON _owner GET "${_inventory}" repository_group)

function(cpkt_sdk_copy source destination)
  if(NOT EXISTS "${source}" AND NOT IS_SYMLINK "${source}")
    message(FATAL_ERROR "Missing SDK input: ${source}")
  endif()
  if(EXISTS "${destination}" OR IS_SYMLINK "${destination}")
    if(IS_SYMLINK "${source}" AND IS_SYMLINK "${destination}")
      file(READ_SYMLINK "${source}" _source_link)
      file(READ_SYMLINK "${destination}" _destination_link)
      if(_source_link STREQUAL _destination_link)
        return()
      endif()
    elseif(NOT IS_SYMLINK "${source}" AND NOT IS_SYMLINK "${destination}")
      file(SHA256 "${source}" _source_hash)
      file(SHA256 "${destination}" _destination_hash)
      if(_source_hash STREQUAL _destination_hash)
        return()
      endif()
    endif()
    message(FATAL_ERROR "SDK payload collision: ${destination}")
  endif()
  get_filename_component(_parent "${destination}" DIRECTORY)
  get_filename_component(_source_name "${source}" NAME)
  file(MAKE_DIRECTORY "${_parent}")
  get_filename_component(_destination_name "${destination}" NAME)
  file(INSTALL "${source}" DESTINATION "${_parent}" TYPE FILE
    RENAME "${_destination_name}" USE_SOURCE_PERMISSIONS)
endfunction()

function(cpkt_sdk_copy_tree source destination)
  if(NOT IS_DIRECTORY "${source}" OR IS_SYMLINK "${source}")
    message(FATAL_ERROR "Missing/unsafe SDK input tree: ${source}")
  endif()
  file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE "${source}/*")
  if(NOT _files)
    message(FATAL_ERROR "Empty SDK input tree: ${source}")
  endif()
  foreach(_file IN LISTS _files)
    file(RELATIVE_PATH _relative "${source}" "${_file}")
    cpkt_sdk_copy("${_file}" "${destination}/${_relative}")
  endforeach()
endfunction()

string(JSON _count LENGTH "${_inventory}" components)
math(EXPR _last "${_count} - 1")
set(CPKT_METADATA_CMAKE "")
set(CPKT_METADATA_PC "")
foreach(_index RANGE 0 ${_last})
  if(_count EQUAL 0)
    break()
  endif()
  string(JSON _component MEMBER "${_inventory}" components ${_index})
  string(JSON _group GET "${_inventory}" components "${_component}" group)
  if(NOT _group STREQUAL _owner)
    continue()
  endif()
  string(JSON _directory GET "${_inventory}" components "${_component}" directory)
  set(_install "${CPKT_SOURCE_DIR}/.cache/deps/${CPKT_TARGET_ID}/${_directory}/install")
  foreach(_kind include lib)
    file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE "${_install}/${_kind}/*")
    foreach(_file IN LISTS _files)
      file(RELATIVE_PATH _relative "${_install}" "${_file}")
      if(_relative MATCHES "[.]la$|^lib/(pkgconfig/|cmake/|engines-|ossl-modules/)")
        continue()
      endif()
      cpkt_sdk_copy("${_file}" "${_stage_root}/${_relative}")
    endforeach()
  endforeach()
  string(JSON _package GET "${_inventory}" components "${_component}" package)
  foreach(_kind cmake pkgconfig)
    string(JSON _metadata_count LENGTH "${_package}" "${_kind}")
    if(_metadata_count GREATER 0)
      math(EXPR _end "${_metadata_count} - 1")
      foreach(_item RANGE 0 ${_end})
        string(JSON _value GET "${_package}" "${_kind}" ${_item})
        if(_kind STREQUAL "cmake")
          list(APPEND CPKT_METADATA_CMAKE "${_value}")
        else()
          list(APPEND CPKT_METADATA_PC "${_value}")
        endif()
      endforeach()
    endif()
  endforeach()
  string(JSON _license GET "${_package}" license)
  if(_license MATCHES "^@")
    string(SUBSTRING "${_license}" 1 -1 _license)
    set(_license "${CPKT_SOURCE_DIR}/${_license}")
  else()
    set(_license "${CPKT_SOURCE_DIR}/.cache/deps-build/${CPKT_TARGET_ID}/${_directory}/${_license}")
  endif()
  cpkt_sdk_copy("${_license}" "${_stage_root}/share/doc/cpkt/${_owner}/third_party/${_component}/LICENSE")
  string(JSON _facade_count LENGTH "${_package}" facades)
  if(_facade_count GREATER 0)
    math(EXPR _end "${_facade_count} - 1")
    foreach(_facade_index RANGE 0 ${_end})
      string(JSON _facade GET "${_package}" facades ${_facade_index})
      string(JSON _cmake GET "${_facade}" cmake)
      string(JSON _pc GET "${_facade}" pkgconfig)
      list(APPEND CPKT_METADATA_CMAKE "${_cmake}")
      list(APPEND CPKT_METADATA_PC "${_pc}")
      string(JSON _header_count LENGTH "${_facade}" headers)
      math(EXPR _header_end "${_header_count} - 1")
      foreach(_header_index RANGE 0 ${_header_end})
        string(JSON _header GET "${_facade}" headers ${_header_index})
        if(_header MATCHES "^@")
          string(JSON _generated GET "${_facade}" generated)
          file(GLOB_RECURSE _headers "${CPKT_BINARY_DIR}/generated/${_generated}/*.h")
          foreach(_source IN LISTS _headers)
            if(_source MATCHES "private|_bridge[.]inc$")
              continue()
            endif()
            if(_source MATCHES "/include/(cpkt/.*)$")
              set(_relative "${CMAKE_MATCH_1}")
            elseif(_source MATCHES "/cpkt/([^/]+)$")
              set(_relative "cpkt/${CMAKE_MATCH_1}")
            else()
              continue()
            endif()
            cpkt_sdk_copy("${_source}" "${_stage_root}/include/${_relative}")
          endforeach()
        else()
          cpkt_sdk_copy("${CPKT_SOURCE_DIR}/include/cpkt/${_header}" "${_stage_root}/include/cpkt/${_header}")
        endif()
      endforeach()
    endforeach()
  endif()
endforeach()

set(_docs "${_stage_root}/share/doc/cpkt/${_owner}")
cpkt_sdk_copy("${CPKT_SOURCE_DIR}/LICENSE" "${_docs}/LICENSE")
string(JSON _group_package GET "${_inventory}" groups "${_owner}" package)
foreach(_kind docs examples extra_notices)
  string(JSON _count LENGTH "${_group_package}" "${_kind}")
  if(_count EQUAL 0)
    continue()
  endif()
  math(EXPR _last "${_count} - 1")
  foreach(_index RANGE 0 ${_last})
    string(JSON _source GET "${_group_package}" "${_kind}" ${_index})
    get_filename_component(_name "${_source}" NAME)
    if(_kind STREQUAL "docs")
      cpkt_sdk_copy("${CPKT_SOURCE_DIR}/${_source}" "${_docs}/docs/${_name}")
    elseif(_kind STREQUAL "examples")
      string(REGEX REPLACE "^examples/" "" _relative "${_source}")
      cpkt_sdk_copy("${CPKT_SOURCE_DIR}/${_source}" "${_docs}/examples/${_relative}")
    else()
      cpkt_sdk_copy_tree("${CPKT_SOURCE_DIR}/${_source}" "${_docs}/third_party/${_name}")
    endif()
  endforeach()
endforeach()
string(JSON _count LENGTH "${_group_package}" files)
if(_count GREATER 0)
  math(EXPR _last "${_count} - 1")
  foreach(_index RANGE 0 ${_last})
    string(JSON _source GET "${_group_package}" files ${_index} source)
    string(JSON _destination GET "${_group_package}" files ${_index} path)
    cpkt_sdk_copy("${CPKT_SOURCE_DIR}/${_source}" "${_stage_root}/${_destination}")
  endforeach()
endif()
if(_owner STREQUAL "core")
  cpkt_sdk_copy("${CPKT_SOURCE_DIR}/LICENSE" "${_stage_root}/share/doc/cpkt/LICENSE")
  cpkt_sdk_copy("${CPKT_SOURCE_DIR}/docs/sdk-installation.md" "${_stage_root}/share/doc/cpkt/README.md")
  cpkt_sdk_copy("${CPKT_SOURCE_DIR}/scripts/validate-sdk.py" "${_stage_root}/share/cpkt/validate-sdk.py")
  cpkt_sdk_copy("${CPKT_SOURCE_DIR}/cmake/payload-ownership.json" "${_stage_root}/share/cpkt/payload-ownership.json")
  cpkt_sdk_copy("${CPKT_SOURCE_DIR}/cmake/CpktSDKValidate.cmake" "${_stage_root}/lib/cmake/CpktSDK/Validate.cmake")
  cpkt_sdk_copy_tree("${CPKT_SOURCE_DIR}/.cache/deps/${CPKT_TARGET_ID}/mqtt-c/install/share/cpkt/mqtt-c" "${_stage_root}/share/cpkt/mqtt-c")
endif()
if(_owner STREQUAL "misc" AND NOT CPKT_TARGET_ID MATCHES "darwin$")
  foreach(_variable CPKT_CXX_STDLIB_STATIC_LIBRARY CPKT_CXX_LIBGCC_STATIC_LIBRARY)
    get_filename_component(_name "${${_variable}}" NAME)
    cpkt_sdk_copy("${${_variable}}" "${_stage_root}/lib/cpkt-cxx/${_name}")
  endforeach()
endif()
list(REMOVE_DUPLICATES CPKT_METADATA_CMAKE)
list(REMOVE_DUPLICATES CPKT_METADATA_PC)
include("${CPKT_SOURCE_DIR}/cmake/package_metadata.cmake")
include("${CPKT_SOURCE_DIR}/cmake/sdk-discovery.cmake")
